<div class="col-md-8 mx-auto">
  <div class="container">
    <h1 class="text-center fw-bold my-4">
      <%= t('.title') %>
    </h1>

    <table class="table table-striped table-hover align-middle">
      <thead  class="table-dark">
        <tr>
          <th><%= t('admin.shared.id') %></th>
          <th><%= t('admin.shared.name') %></th>
          <th><%= t('admin.shared.role') %></th>
        </tr>
      </thead>

      <tbody>
        <% @users.each do |user| %>
          <tr>
            <td><%= user.id %></td>
            <td>
              <%= link_to admin_user_path(user), class: "text-decoration-none" do %>
                <% if user.avatar.attached? %>
                  <%= image_tag user.avatar, width: 20, height: 20, class: "rounded-circle mb-1" %>
                <% end %>
                <%= user.name %>
              <% end %>
            </td>
            <td><%= user.role %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <div class="mb-3 py-md-4">
      <%== @pagy.series_nav %>
    </div>
  </div>
</div>