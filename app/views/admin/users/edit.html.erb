<div class="container py-4">
  <h1 class="mb-4 my-md-5 text-center">
    <%= t('.title') %>
  </h1>

  <div class="card col-md-6 mx-auto">
    <div class="card-header">
      <%= t('admin.shared.info') %>
    </div>

    <div class="card-body">
      <%= form_with model: [:admin, @user] do |f| %>

        <% render "shared/error_messages", object: @user %>

        <div class="mb-3">
          <%= f.label :name, t('admin.shared.name'), class: "form-label" %>
          <%= f.text_field :name, class: "form-control" %>
        </div>

        <div class="mb-3">
          <%= f.label :email, t('admin.shared.email'), class: "form-label" %>
          <%= f.email_field :email, class: "form-control" %>
        </div>

        <div class="mb-4">
          <%= f.label :role, t('admin.shared.role'), class: "form-label" %>
          <%= f.select :role,
              User.roles.keys.map { |role| [role.humanize, role] },
              {},
              class: "form-select" %>
        </div>

        <div class="mb-3 text-center">
          <%= f.submit class: "btn btn-primary" %>

          <%= link_to t('admin.shared.cancel'),
              admin_user_path(@user),
              class: "btn btn-secondary" %>
        </div>

      <% end %>
    </div>
  </div>
</div>
