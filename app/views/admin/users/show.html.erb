<div class="container py-4">
  <h1 class="mb-4 my-md-5 text-center">
    <%= t('.title') %>
  </h1>

  <div class="card col-md-6 mx-auto">
    <div class="card-header">
      <%= t('admin.shared.info') %>
    </div>

    <div class="card-body">
      <dl class="row mb-0">
        <dt class="col-sm-3"><%= t('admin.shared.id') %></dt>
        <dd class="col-sm-9"><%= @user.id %></dd>

        <dt class="col-sm-3"><%= t('admin.shared.name') %></dt>
        <dd class="col-sm-9"><%= @user.name %></dd>

        <dt class="col-sm-3"><%= t('admin.shared.email') %></dt>
        <dd class="col-sm-9"><%= @user.email %></dd>

        <dt class="col-sm-3"><%= t('admin.shared.role') %></dt>
        <dd class="col-sm-9"><%= @user.role %></dd>

        <dt class="col-sm-3"><%= t('admin.shared.created_at') %></dt>
        <dd class="col-sm-9"><%= @user.created_at.strftime("%Y/%m/%d") %></dd>
      </dl>
    </div>
  </div>

  <div class="d-flex gap-2 mt-4 mt-md-5 justify-content-center">
    <%= link_to t('defaults.edit'), edit_admin_user_path(@user), class: "btn btn-primary" %>
    <%= link_to t('.to_admin_users'), admin_users_path, class: "btn btn-secondary" %>
    <%= button_to t('defaults.delete'), admin_user_path(@user), class: "btn btn-danger",
          method: :delete, data: { turbo_confirm: t('defaults.delete_confirm') } %>
  </div>
</div>
