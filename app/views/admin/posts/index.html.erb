<div class="col-md-8 mx-auto">
  <div class="container">
    <h1 class="text-center fw-bold my-4">
      <%= t('.title') %>
    </h1>

    <table class="table table-striped table-hover align-middle">
      <thead  class="table-dark">
        <tr>
          <th><%= t('admin.shared.id') %></th>
          <th><%= t('admin.shared.name') %></th>
          <th><%= t('admin.shared.post_title') %></th>
        </tr>
      </thead>

      <tbody>
        <% @posts.each do |post| %>
          <tr>
            <td><%= post.id %></td>
            <td>
              <% if post.user.avatar.attached? %>
                <%= image_tag post.user.avatar, width: 20, height: 20, class: "rounded-circle mb-1" %>
              <% end %>
              <%= post.user.name %></td>
            <td><%= link_to post.title, admin_post_path(post), class: "text-decoration-none" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <div class="mb-3 py-md-4">
      <%== @pagy.series_nav %>
    </div>
  </div>
</div>