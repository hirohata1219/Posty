<div class="py-5 col-md-8 mx-auto">
  <div class="container">
    <h1 class="text-center fw-bold my-5">
      <%= t('.title') %>
    </h1>

    <table class="table table-striped table-hover align-middle">
      <thead  class="table-dark">
        <tr>
          <th><%= t('admin.shared.id') %></th>
          <th><%= t('admin.shared.name') %></th>
          <th><%= t('admin.shared.post_title') %></th>
        </tr>
      </thead>

      <tbody>
        <% @posts.each do |post| %>
          <tr>
            <td><%= post.id %></td>
            <td><%= post.user.name %></td>
            <td><%= link_to post.title, admin_post_path(post), class: "text-decoration-none" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>