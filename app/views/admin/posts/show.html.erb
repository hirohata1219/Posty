<div class="container py-4 col-md-6">
  <h1 class="mb-4 my-md-5 text-center">
    <%= t('.title') %>
  </h1>

  <div class="card mx-auto">
    <div class="card-header">
      <%= t('admin.shared.post_info') %>
    </div>

    <div class="card-body">
      <dl class="row m-4">
        <dt class="col-sm-3"><%= t('admin.shared.name') %></dt>

        <dd class="col-sm-9 d-flex align-items-center">
          <%= link_to admin_user_path(@post.user), class: "text-decoration-none" do %>
            <% if @post.user.avatar.attached? %>
              <%= image_tag @post.user.avatar, width: 20, height: 20, class: "rounded-circle mb-1" %>
            <% end %>
            <%= @post.user.name %>
          <% end %>
        </dd>

        <dt class="col-sm-3"><%= t('admin.shared.post_id') %></dt>
        <dd class="col-sm-9"><%= @post.id %></dd>

        <dt class="col-sm-3"><%= t('admin.shared.post_created_at') %></dt>
        <dd class="col-sm-9"><%= @post.created_at.strftime("%Y/%m/%d") %></dd>
      </dl>

      <article class="card p-3 m-2">
        <div class="card-body">
          <h4 class="mb-3">
            <%= @post.title %>
          </h4>
          <% if @post.image.attached? %>
            <%= image_tag @post.image, class: "img-fluid rounded object-fit-contain my-4" %>
          <% end %>

          <%= simple_format(@post.body, class: "mb-0") %>
        </div>
      </article>
    </div>
  </div>

  <div class="d-flex gap-2 mt-4 mt-md-5 justify-content-center">
    <%= link_to t('defaults.edit'), edit_admin_post_path(@post), class: "btn btn-primary" %>
    <%= link_to t('.to_admin_posts'), admin_posts_path, class: "btn btn-secondary" %>
    <%= button_to t('defaults.delete'), admin_post_path(@post), class: "btn btn-danger",
          method: :delete, data: { turbo_confirm: t('defaults.delete_confirm') } %>
  </div>
</div>
