<aside
  class="d-none d-md-block bg-dark text-white p-5 text-center"
  style="width: 240px;">

  <h4 class="pb-3 border-bottom">
    <%= t('admin.shared.title') %>
  </h4>

  <nav>
    <ul class="nav flex-column py-5 gap-3">

      <li class="nav-item">
        <%= link_to t('admin.shared.dashboard'),
            admin_root_path,
            class: "nav-link text-white" %>
      </li>

      <li class="nav-item">
        <%= link_to t('admin.shared.users'),
            admin_users_path,
            class: "nav-link text-white" %>
      </li>

      <li class="nav-item">
        <%= link_to t('admin.shared.posts'),
            admin_posts_path,
            class: "nav-link text-white" %>
      </li>

    </ul>
  </nav>

  <%= link_to t('defaults.to_index'),
      root_path,
      class: "btn btn-outline-light btn-sm" %>

</aside>