<div class="col-md-6 mx-auto">
  <h1 class="text-center fw-bold my-5">
    <%= t('.title') %>
  </h1>
  
  <div class="container">
    <% if @posts.any? %>
      <div class="container pb-3">
        <%= form_with url: search_posts_path, method: :get, local: true, class: "d-flex" do |f| %>
          <%= f.search_field :q, value: @query, class: "form-control me-2", placeholder: t('.search_placeholder') %>
          <%= f.submit t('.search'), class: "btn btn-outline-primary" %>
        <% end %>
      </div>
      <div class="posts-grid my-3">
        <% @posts.each do |post| %>
          <article class="card p-1">
            <div class="card-body">
              <div class="d-flex justify-content-between">
                <h2>
                  <%= link_to post.title, post_path(post), class: "text-decoration-none" %>
                </h2>
                <div class="text-muted small">
                  <%= time_ago_in_words(post.created_at) %>
                </div>
              </div>
              <div class="d-flex align-items-center mb-3">
                <%= t('defaults.poster') %>:
                <% profile_link = post.user == current_user ? profile_path : user_path(post.user) %>
                <%= link_to profile_link, class: "d-flex align-items-center text-decoration-none" do %>
                  <% if post.user.avatar.attached? %>
                    <%= image_tag post.user.avatar, width: 20, height: 20, class: "rounded-circle ms-2" %>
                  <% end %>
                  <span class="small ms-1">
                    <%= post.user.name %>
                  </span>
                <% end %>
              </div>
              <%= truncate(post.body, length: 20) %>
              
              <% if current_user == post.user %>
                <div class="d-flex gap-3 mt-4">
                  <%= link_to t('defaults.edit'), edit_post_path(post), class: "btn btn-outline-warning btn-sm" %>
                  <%= button_to t('defaults.delete'), post_path(post), class: "btn btn-outline-danger btn-sm",
                      method: :delete, data: { turbo_confirm: t('defaults.delete_confirm') } %>
                </div>
              <% end %>
            </div>
          </article>
        <% end %>
      </div>

      <div class="mb-3 py-md-4">
        <%== @pagy.series_nav %>
      </div>

    <% else %>
      <p class="mb-5 p-5 text-center">
        <%= t(".no_result") %>
      </p>
    <% end %>

  </div>
</div>