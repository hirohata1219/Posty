<div class="col-md-5 mx-auto py-5">
  <h1 class="text-center fw-bold">
    <%= t('.title') %>
  </h1>

  <%= render "shared/error_messages", object: @user %>

  <%= form_with model: @user, url: profile_path do |f| %>
    <div class="p-3">
      <div class="mb-3">
        <%= f.label :name, class: "form-label" %>
        <%= f.text_field :name, placeholder: t('.name_placeholder'), class: "form-control" %>
      </div>
      <div class="mb-3">
        <%= f.label :email, class: "form-label" %>
        <%= f.email_field :email, placeholder: t('defaults.email_placeholder'), class: "form-control" %>
      </div>
      <div class="mb-3">
        <%= f.label :avatar, class: "form-label mb-0" %>
        <div class="mb-2">
          <% if @user.avatar.attached? %>
            <span class="text-muted small">
              <%= t('.present_avatar') %>：<%= @user.avatar.filename %>
            </span>
          <% end %>
        </div>
        <%= f.file_field :avatar, class: "form-control" %>
      </div>
      <div class="mb-3">
        <%= f.label :bio, class: "form-label" %>
        <%= f.text_area :bio, class: "form-control resize" %>
      </div>
      <div class="mb-3 text-center">
        <button type="button"
                data-action="click->ai-post#improve"
                data-ai-post-target="button"
                class="btn btn-outline-success">
          <%= t('.ai_improve') %>
        </button>
      </div>
      <div class="mb-5 text-center">
        <span data-ai-post-target="status"></span>
      </div>
      <div class="mb-4">
        <%= f.submit class: "btn btn-primary w-100" %>
      </div>
    </div>

  <% end %>

  <div class="text-center">
    <%= link_to t('.back_to_profile'), profile_path %>
  </div>

</div>