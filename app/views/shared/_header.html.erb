<header class="border-bottom bg-white py-4">
  <nav class="navbar navbar-expand-lg">
    <div class="container">
      <%= link_to "Posty", root_path, class: "navbar-brand fw-bold" %>

      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMenu"
              aria-controls="navbarMenu" aria-expanded="false" aria-label="メニューを開く">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse mt-4" id="navbarMenu">
        <div class="ms-auto d-flex flex-column flex-lg-row gap-2">

          <%= link_to t('header.post_index'), posts_path, class: "btn btn-outline-secondary" %>
          <%= link_to t('header.create_post'), new_post_path, class: "btn btn-outline-warning" %>
          <%= link_to t('header.profile'), profile_path, class: "btn btn-outline-primary" %>
          <%= button_to t('header.logout'), logout_path, method: :delete, class: "btn btn-outline-danger phone" %>
          <% if current_user&.admin? %>
            <%= link_to t('.admin_root'), admin_root_path, class: "btn btn-dark phone" %>
          <% end %>

        </div>
      </div>
    </div>
  </nav>
</header>