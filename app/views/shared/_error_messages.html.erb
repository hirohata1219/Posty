<% if object.errors.any? %>
  <div class="alert alert-danger">
    <% object.errors.each do |error| %>
      <ul class="mb-0 list-unstyled">
        <li>
          <% if error.attribute == :password_confirmation && error.type == :confirmation %>
            <%= error.message %>
          <% else %>
            <%= error.full_message %>
          <% end %>
        </li>
      </ul>
    <% end %>
  </div>
<% end %>